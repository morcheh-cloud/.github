# Values for compose.yml. In Arcane: paste them into the project's .env.
# Every secret: openssl rand -hex 24.

# Where visitors open the demo, and where their browsers reach its API. Point
# both at your reverse proxy (see the top of compose.yml).
DEMO_DOMAIN=demo.morche.cloud
DEMO_API_DOMAIN=demo-api.morche.cloud
# The Docker network your reverse proxy is on.
PROXY_NETWORK=proxy

# Minutes between resets, counted from midnight UTC (60 = on the hour).
DEMO_RESET_MINUTES=60

MORCHE_VERSION=latest
DEMO_VERSION=latest

POSTGRES_PASSWORD=
REDIS_PASSWORD=
# openssl rand -base64 32. Keep it: the snapshot's saved passwords need it.
SECRETS_KEY=
SETUP_TOKEN=
# The admin account, for whoever runs the demo (Sign in with an account).
ADMIN_PASSWORD=
# The lab servers' and databases' password. Visitors never see it (they're
# Engineers), and it only guards throwaway containers.
LAB_PASSWORD=

# The lab servers run systemd and Docker with visitors as root: they need
# Sysbox (see README). Change only to another runtime that isolates as well.
LAB_RUNTIME=sysbox-runc
