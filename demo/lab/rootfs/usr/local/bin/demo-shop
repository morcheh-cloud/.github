#!/usr/bin/env python3
# A tiny "app" behind nginx, so the demo has a real service to start, stop,
# read logs of and monitor.
import json, random, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

class App(BaseHTTPRequestHandler):
    def do_GET(self):
        time.sleep(random.uniform(0.005, 0.08))
        body = json.dumps({"ok": True, "path": self.path, "items": random.randint(1, 40)})
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(body.encode())

ThreadingHTTPServer(("127.0.0.1", 3000), App).serve_forever()
