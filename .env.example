# Copy to .env next to compose.yml and fill in (or run ./install.sh, which
# does it for you).

# Image version: latest (newest build of the main branch) or a release like
# 0.1.0 to choose when you move.
MORCHE_VERSION=latest

# Where people open the panel, and where their browsers reach the backend.
# Use the address others will type: a domain or this machine's IP, not
# localhost (unless only this machine will use it).
PANEL_URL=http://192.168.1.10:3200
API_URL=http://192.168.1.10:8080
PANEL_PORT=3200
BACKEND_PORT=8080
# 127.0.0.1 = reachable only from this machine (e.g. behind your own proxy).
PANEL_BIND=0.0.0.0
BACKEND_BIND=0.0.0.0

# openssl rand -hex 24 for each
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Seals every stored credential: openssl rand -base64 32. KEEP A COPY:
# losing it makes the saved passwords and keys unreadable.
SECRETS_KEY=
# Asked for by the first-run form, so nobody else can claim the panel before
# you do (openssl rand -hex 24).
SETUP_TOKEN=

# true while the panel is served over plain http (the session cookie is
# Secure otherwise). Behind https set false.
COOKIE_INSECURE=true
# true only behind a proxy that sets X-Forwarded-For.
TRUST_PROXY=false
TZ=UTC
